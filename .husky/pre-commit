# Guards the exact drift that slipped into commit abded9c on 2026-09-19:
# editing skills/*/SKILL.md without re-running the cross-harness export
# scripts (AGENTS.md, CATALOG.md, dist/*.skill, .cursor/rules, etc.) that
# CI's export-targets-sync job checks on every push. Mirrors
# .github/workflows/ci.yml's validate/dist-sync/export-targets-sync jobs,
# but scoped to only run when skills/, agents/ or the generators changed
# (agents/ was once missing here, so agent edits could reach CI unsynced).

# Benchmark records under evals/review-seeded-bugs/results*/runs/ are
# append-only: e072dc1 (2026-10-08) overwrote the committed 60-run v1
# summary with a one-run spot check. Refuse a commit that edits or deletes one.
python evals/review-seeded-bugs/run.py --check-records || exit 1
python evals/build-fix/run.py --check-records || exit 1

STAGED=$(git diff --cached --name-only -- 'skills/' 'agents/' 'scripts/' 'rules/')
if [ -z "$STAGED" ]; then
  exit 0
fi

echo "skills/, agents/, scripts/ or rules/ changed — validating and checking cross-harness export sync..."

FAIL=0
python scripts/validate_skills.py || FAIL=1
# The generator list lives in scripts/regen_all.py only. The changelog is
# skipped here: it changes at release time, and a clone without tags would
# see it as stale.
python scripts/regen_all.py --check --skip generate_changelog || FAIL=1

if [ "$FAIL" -ne 0 ]; then
  echo ""
  echo "One or more cross-harness exports are stale (would fail CI)."
  echo "Run: python scripts/regen_all.py, git add the results, then commit again."
  exit 1
fi
