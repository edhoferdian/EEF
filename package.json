{
  "name": "eef-install",
  "version": "1.17.4",
  "description": "Install Ekosistem Edho Ferdian's 38 skills and 46 sub-agents into Claude Code, OpenCode, Cursor, Windsurf, Devin, Cline, GitHub Copilot, Kiro, Hermes Agent, OpenClaw, or ZCode — no git clone required.",
  "license": "MIT",
  "author": {
    "name": "Edho Ferdian",
    "email": "edhoferdian31@gmail.com",
    "url": "https://github.com/edhoferdian"
  },
  "homepage": "https://github.com/edhoferdian/EEF#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edhoferdian/EEF.git"
  },
  "bin": {
    "eef-install": "bin/eef.js"
  },
  "files": [
    "bin/",
    "skills/",
    "rules/",
    "AGENTS.md",
    "GEMINI.md",
    ".cursor/",
    ".windsurf/",
    ".devin/",
    ".clinerules/",
    ".github/copilot-instructions.md",
    ".kiro/",
    ".hermes/",
    ".agents/",
    ".zcode/",
    ".claude/agents/",
    "dist/agents/"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "claude-code",
    "claude",
    "skills",
    "cursor",
    "windsurf",
    "cline",
    "copilot",
    "agents-md",
    "kiro",
    "hermes",
    "openclaw",
    "zcode",
    "opencode",
    "agent-skills",
    "sub-agents",
    "agent-orchestration",
    "ai-coding-agent"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "husky": "^9.1.7"
  },
  "scripts": {
    "prepare": "husky || true"
  }
}
